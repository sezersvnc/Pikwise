@baseUrl = http://localhost:5080
# Set these IDs to existing lookup rows in your local PikwiseDb.
@brandId = 1
@categoryId = 1
# Set these to two or three existing, different product IDs.
@comparisonProductId1 = 1
@comparisonProductId2 = 2
@comparisonProductId3 = 3

### Current profile without a token (401)
GET {{baseUrl}}/api/auth/me

### Current profile with a Supabase user access token (200)
# Set PIKWISE_ACCESS_TOKEN in the local environment; do not save a token here.
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{$processEnv PIKWISE_ACCESS_TOKEN}}

### Local Admin policy (403 for User, 204 for local Admin)
GET {{baseUrl}}/api/auth/admin-check
Authorization: Bearer {{$processEnv PIKWISE_ACCESS_TOKEN}}

### Invalid token (401)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer invalid

### List products (paged response; products are in items)
GET {{baseUrl}}/api/products

### Combined catalog filters, lowest price first
GET {{baseUrl}}/api/products?minPrice=20000&maxPrice=50000&brandId={{brandId}}&minRam=16&minStorage=512&cpu=Core&gpu=RTX&sortBy=price&page=1&pageSize=20

### Second page, highest RAM first
GET {{baseUrl}}/api/products?sortBy=ram&sortDirection=desc&page=2&pageSize=5

### Invalid page size (400 ValidationProblemDetails)
GET {{baseUrl}}/api/products?pageSize=101

### Compare two products (200, products in selection order)
GET {{baseUrl}}/api/products/compare?ids={{comparisonProductId2}}&ids={{comparisonProductId1}}

### Compare three products (200)
GET {{baseUrl}}/api/products/compare?ids={{comparisonProductId1}}&ids={{comparisonProductId2}}&ids={{comparisonProductId3}}

### Duplicate selection (400)
GET {{baseUrl}}/api/products/compare?ids={{comparisonProductId1}}&ids={{comparisonProductId1}}

### Missing products (404, missingProductIds)
GET {{baseUrl}}/api/products/compare?ids=2147483647&ids=2147483646

### Create a product (201, Location)
# @name createProduct
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Local test laptop",
  "price": 35000.25,
  "stock": 4,
  "isActive": true,
  "brandId": {{brandId}},
  "categoryId": {{categoryId}},
  "specification": {
    "processor": "Example CPU",
    "gpu": "Example GPU",
    "ramGb": 16,
    "storageGb": 512,
    "screenSize": 15.6,
    "resolution": "1920x1080",
    "refreshRate": 144,
    "weight": 1.875,
    "operatingSystem": "Example OS"
  }
}

### Read the newly created product
GET {{baseUrl}}/api/products/{{createProduct.response.body.$.id}}

### Add the newly created product to the current user's favorites (201)
POST {{baseUrl}}/api/favorites/{{createProduct.response.body.$.id}}
Authorization: Bearer {{$processEnv PIKWISE_ACCESS_TOKEN}}

### List only the current user's favorites (200)
GET {{baseUrl}}/api/favorites
Authorization: Bearer {{$processEnv PIKWISE_ACCESS_TOKEN}}

### Repeat the add to verify duplicate handling (409)
POST {{baseUrl}}/api/favorites/{{createProduct.response.body.$.id}}
Authorization: Bearer {{$processEnv PIKWISE_ACCESS_TOKEN}}

### Remove only this user's favorite; the product remains (204)
DELETE {{baseUrl}}/api/favorites/{{createProduct.response.body.$.id}}
Authorization: Bearer {{$processEnv PIKWISE_ACCESS_TOKEN}}

### Update the same product (200)
PUT {{baseUrl}}/api/products/{{createProduct.response.body.$.id}}
Content-Type: application/json

{
  "name": "Updated local test laptop",
  "price": 36000.50,
  "stock": 2,
  "isActive": true,
  "brandId": {{brandId}},
  "categoryId": {{categoryId}},
  "specification": {
    "processor": "Example CPU",
    "gpu": "Example GPU",
    "ramGb": 32,
    "storageGb": 1024,
    "screenSize": 15.6,
    "resolution": "1920x1080",
    "refreshRate": 144,
    "weight": 1.875,
    "operatingSystem": "Example OS"
  }
}

### Delete only the product created above (204)
DELETE {{baseUrl}}/api/products/{{createProduct.response.body.$.id}}

### Missing product (404)
GET {{baseUrl}}/api/products/2147483647
